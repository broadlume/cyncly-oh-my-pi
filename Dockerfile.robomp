# syntax=docker/dockerfile:1.7-labs
###############################################################################
# robomp — GitHub triage+fix bot orchestrator.
#
# Self-contained image: builds the SolidJS dashboard bundle and the omp_rpc
# wheel from this repo, and downloads the prebuilt `omp` binary from upstream
# can1357/oh-my-pi GitHub releases (pinned by OMP_VERSION). No base image
# from a monorepo source build.
#
# Build (from repo root):
#     docker build -f Dockerfile.robomp -t robomp:dev .
#
# Compose (recommended):
#     docker compose --project-directory python/robomp build
###############################################################################

ARG BUN_VERSION=1.3.14
ARG OMP_VERSION=v17.3.1
ARG NODE_VERSION=22.23.2

############################
# 1) web-builder — Bun + Vite, builds the SolidJS dashboard bundle.
############################
FROM oven/bun:${BUN_VERSION}-slim AS web-builder
WORKDIR /work/web
COPY python/robomp/web/package.json python/robomp/web/bun.lock ./
RUN bun install --frozen-lockfile
COPY --exclude=node_modules --exclude=dist python/robomp/web/ ./
RUN bun run build

############################
# 2) wheel-builder — builds the omp_rpc wheel.
############################
FROM python:3.12-slim-bookworm AS wheel-builder
RUN pip install --upgrade pip build
WORKDIR /src
COPY python/omp-rpc /src
RUN python -m build --wheel --outdir /out

############################
# 3) runtime — python + bun + rustup launcher + upstream omp binary + robomp
############################
FROM python:3.12-slim-bookworm AS runtime

ARG BUN_VERSION
ARG OMP_VERSION
ARG NODE_VERSION
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BUN_INSTALL=/opt/bun \
    CARGO_HOME=/data/cache/cargo \
    CARGO_TARGET_DIR=/data/cache/cargo-target \
    RUSTUP_HOME=/data/cache/rustup \
    COREPACK_HOME=/data/cache/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PATH=/opt/bun/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates unzip openssh-client tini sqlite3 \
        build-essential pkg-config libssl-dev \
        xz-utils chromium fonts-liberation gnupg \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && /opt/bun/bin/bun --version

# Node 22 (verified tarball) + corepack shims for pnpm/yarn. Repos pin their
# package manager via `packageManager`; corepack resolves the version lazily
# into COREPACK_HOME on the /data volume.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://nodejs.org/dist/v${NODE_VERSION}"; \
    curl -fsSL -o /tmp/node.tar.xz "${base}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSL -o /tmp/SHASUMS256.txt "${base}/SHASUMS256.txt"; \
    expected="$(awk -v a="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" '$2 == a { print $1 }' /tmp/SHASUMS256.txt)"; \
    test -n "${expected}"; \
    echo "${expected}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f /tmp/node.tar.xz /tmp/SHASUMS256.txt; \
    node --version; \
    corepack enable --install-directory /usr/local/bin pnpm yarn

# Docker CLI only (client): the daemon is the host's, reached via the mounted
# /var/run/docker.sock. Used to build/run per-repo agent containers.
RUN set -eux; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc; \
    echo "deb [arch=${TARGETARCH} signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends docker-ce-cli; \
    rm -rf /var/lib/apt/lists/*

# Rustup launcher only — the real toolchain is fetched lazily into RUSTUP_HOME
# on first cargo invocation. Keeps the image small while sharing the toolchain
# across reboots when /data is mounted.
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup-bootstrap \
       sh /tmp/rustup-init.sh -y --no-modify-path --default-toolchain none --profile minimal \
    && rm -f /tmp/rustup-init.sh \
    && rm -rf /usr/local/rustup-bootstrap \
    && /usr/local/cargo/bin/rustup --version

# Upstream omp release binary (self-contained compiled build).
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) omp_arch=x64 ;; \
      arm64) omp_arch=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/can1357/oh-my-pi/releases/download/${OMP_VERSION}"; \
    curl -fsSL -o /usr/local/bin/omp "${base}/omp-linux-${omp_arch}"; \
    curl -fsSL -o /tmp/SHA256SUMS.txt "${base}/SHA256SUMS.txt"; \
    expected="$(awk -v a="omp-linux-${omp_arch}" '$2 == a || $2 == "*"a { print $1 }' /tmp/SHA256SUMS.txt)"; \
    test -n "${expected}"; \
    echo "${expected}  /usr/local/bin/omp" | sha256sum -c -; \
    chmod +x /usr/local/bin/omp; \
    rm -f /tmp/SHA256SUMS.txt; \
    /usr/local/bin/omp --version

COPY --from=wheel-builder /out/*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/omp_rpc-*.whl && rm -rf /tmp/wheels

WORKDIR /app

# robomp itself. Drop the Vite-built dashboard into the package tree before
# `pip install` so it lands in the installed wheel (`static/**/*` is declared
# as package-data in pyproject.toml).
COPY python/robomp/pyproject.toml ./
COPY python/robomp/src/ ./src/
COPY --from=web-builder /work/web/dist/ ./src/static/

RUN pip install --no-cache-dir \
        "fastapi>=0.112" "uvicorn[standard]>=0.30" "httpx>=0.27" \
        "pydantic>=2.6" "pydantic-settings>=2.2" "python-dotenv>=1.0" \
        "click>=8.1" \
    && pip install --no-cache-dir --no-deps .

# Agent config arrives in two layers: the image bundle at /srv/agent-home-stage
# and a read-only host mount at /srv/agent-home-override. The entrypoint copies
# layer 1 then layer 2 into root-owned world-readable files under
# /data/agent-home (on the shared volume, visible to agent containers); the
# agent runs with HOME=/data/agent-home, so ~/.omp and ~/.agent resolve there.
RUN mkdir -p /srv/agent-home-stage/.agent /srv/agent-home-stage/.omp/agent

# Versioned agent-config bundle (layer 1); its tree is a literal image of $HOME.
# The host override mount at /srv/agent-home-override is layer 2; the entrypoint
# and the worker copy layer 1 then layer 2 into /data/agent-home.
COPY infra/cdk/robomp/assets/agent-bundle/ /srv/agent-home-stage/
# The AWS compose file travels in the image; user-data extracts it at boot
# (docker cp) instead of inlining 4.8 KB into the 16 KB user-data budget.
COPY python/robomp/docker-compose.aws.yml /opt/robomp/docker-compose.aws.yml
RUN mkdir -p /srv/agent-home-override

COPY python/robomp/entrypoint.sh /usr/local/bin/robomp-entrypoint
RUN chmod +x /usr/local/bin/robomp-entrypoint

VOLUME ["/data"]
EXPOSE 8080
EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/robomp-entrypoint"]
CMD ["python", "-m", "robomp", "serve"]
